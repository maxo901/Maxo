# --- Required on Railway ---
PORT=8080
DATA_DIR=/data            # mount a Railway Volume on /data

# --- Recommended ---
OWNER_EMAIL=you@example.com   # this email becomes the owner (otherwise: first person to register)
APP_NAME=پیام‌رسان
JWT_SECRET=                   # optional; auto-generated and stored in DATA_DIR if empty

# --- Email (pick ONE provider) ---
MAIL_FROM=پیام‌رسان <noreply@yourdomain.com>
# 1) Resend (HTTPS API - works on every Railway plan)
RESEND_API_KEY=
# 2) Brevo (HTTPS API - MAIL_FROM must be a verified sender, plain email)
BREVO_API_KEY=
# 3) SMTP (Railway blocks SMTP on Free/Hobby plans)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# --- Optional ---
MAX_UPLOAD_MB=50
